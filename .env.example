# ─────────────────────────────────────────────────────────────────────────────
# MarksKoi environment variables. Copy to `.env` (never commit `.env`).
# Every variable here is SERVER-ONLY. Do not rename any of them with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL ------------------------------------------------------------------
# Runtime connection. On Supabase use the *transaction pooler* (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"
# Used by Prisma Migrate. On Supabase use the *session pooler* (port 5432) or direct connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Supabase's root CA certificate (Project Settings → Database → SSL Configuration → Download).
# Paste the PEM on one line with \n escapes. Required for Supabase: node-postgres verifies server
# certificates and Supabase's CA isn't in Node's default trust store. Leave empty for local Docker.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nREPLACE_WITH_SUPABASE_CA\n-----END CERTIFICATE-----\n"

# Auth.js (Google OAuth) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_YOUR_SECRET"
AUTH_GOOGLE_ID="REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
# Required behind proxies / on Netlify so Auth.js trusts the forwarded host header.
AUTH_TRUST_HOST="true"

# Public base URL of the deployment (no trailing slash). Used for absolute links.
APP_URL="http://localhost:3000"

# Exact email domains (comma-separated). An address must match exactly one list.
STUDENT_EMAIL_DOMAINS="g.bracu.ac.bd"
FACULTY_EMAIL_DOMAINS="bracu.ac.bd"

# Google Sheets service account ------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL="REPLACE_WITH_SERVICE_ACCOUNT@YOUR_PROJECT.iam.gserviceaccount.com"
# The PEM private key from the JSON key file. Keep the \n escapes on one line.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"
# Local development only (alternative to the two variables above): path to the JSON key file.
# Ignored when NODE_ENV=production. Keep the file outside the repository or in /secrets/.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE="./secrets/service-account.json"

# "google" (default) or "fixture" (local development / E2E only — refused in production).
SHEETS_DRIVER="google"
# SHEETS_FIXTURE_FILE="./e2e/.runtime/sheets.json"

# Synchronization --------------------------------------------------------------
# Bearer token required by /api/cron/sync. Generate with: openssl rand -hex 32
CRON_SECRET="REPLACE_WITH_YOUR_SECRET"
# Each course is synced at least this often: by the scheduler, and when faculty open the course.
SYNC_INTERVAL_MINUTES="15"
# Results older than this are shown with a "may be out of date" indicator to faculty.
SYNC_STALE_AFTER_MINUTES="60"
# Maximum offerings processed per scheduled invocation (keeps function time bounded).
SYNC_BATCH_SIZE="10"
