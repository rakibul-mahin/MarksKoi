{
  "name": "syncscore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server --env-file=.env scripts/seed.ts",
    "db:studio": "prisma studio",
    "admin:grant": "tsx --conditions=react-server --env-file=.env scripts/admin-cli.ts grant",
    "admin:revoke": "tsx --conditions=react-server --env-file=.env scripts/admin-cli.ts revoke",
    "admin:list": "tsx --conditions=react-server --env-file=.env scripts/admin-cli.ts list",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "google-auth-library": "^11.2.0",
    "lucide-react": "1.45.0",
    "motion": "12.43.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "6.19.3",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "6",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.19 <21 || >=22.11"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
